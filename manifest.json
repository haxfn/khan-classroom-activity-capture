{
  "manifest_version": 3,
  "name": "Khan Classroom Activity Capture",
  "version": "1.0.0",
  "description": "Capture the Activity Overview data from your current Khan Academy page for local export.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.khanacademy.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capture Khan Academy activity",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.khanacademy.org/teacher/class/*/overview/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.khanacademy.org/teacher/class/*/overview/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
